{
  "name": "parakeet.ts",
  "version": "1.0.0",
  "description": "TypeScript runtime for Nvidia Parakeet ASR models (community port, not affiliated with NVIDIA)",
  "license": "MIT",
  "keywords": [
    "asr",
    "speech-recognition",
    "parakeet",
    "mlx",
    "apple-silicon",
    "cuda",
    "whisper-alternative",
    "transcription",
    "nvidia"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "parakeet": "./dist/mlx/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mlx": {
      "import": "./dist/mlx/index.js",
      "types": "./dist/mlx/index.d.ts"
    },
    "./mlx/server": {
      "import": "./dist/mlx/server.js",
      "types": "./dist/mlx/server.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && chmod +x dist/mlx/cli.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@mlx-node/core": "^0.0.7"
  },
  "peerDependencies": {
    "hono": "^4"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "hono": "^4.12.18",
    "typescript": "^5.5.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18.11.0"
  }
}
